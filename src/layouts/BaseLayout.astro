---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import SchemaMarkup, { type BreadcrumbItem, type FAQItem } from '../components/SchemaMarkup.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FAQItem[];
  schemaType?: 'WebApplication' | 'WebSite';
  currentPath?: string;
  noindex?: boolean;
}

const {
  title = 'Fantasy & RPG Name Generator — 100,000+ Lore-Friendly Names',
  description = 'Generate endless unique, lore-friendly fantasy names for D&D 5e, Pathfinder, fantasy writing, and worldbuilding. 1-click copy & save your favorites.',
  canonical,
  ogImage = 'https://realmforge.app/og-image.png',
  breadcrumbs = [],
  faqs = [],
  schemaType = 'WebApplication',
  currentPath = '/',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <!-- Exhaustive Technical SEO Head Component -->
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
    />

    <!-- Fonts: Cinzel & Plus Jakarta Sans with Crossorigin Preconnect -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Validated Structured Data Engines (JSON-LD) -->
    <SchemaMarkup
      name={title}
      description={description}
      url={canonical || 'https://realmforge.app/'}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      type={schemaType}
    />
  </head>
  <body class="bg-[#080b11] text-slate-100 min-h-screen flex flex-col antialiased selection:bg-amber-500/30 selection:text-amber-200">
    <Header currentPath={currentPath} />
    
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 overflow-x-hidden">
      <slot />
    </main>

    <Footer />
  </body>
</html>
