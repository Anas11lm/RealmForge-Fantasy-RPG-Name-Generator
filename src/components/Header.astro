---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { label: 'Elf Names', path: '/fantasy-races/elf-names' },
  { label: 'Dwarf Names', path: '/fantasy-races/dwarf-names' },
  { label: 'Orc Names', path: '/fantasy-races/orc-names' },
  { label: 'Tavern Names', path: '/locations/tavern-names' },
  { label: 'Dragon Names', path: '/creatures/dragon-names' },
  { label: 'About & Lore', path: '/about' },
];
---

<header class="sticky top-0 z-30 w-full bg-[#080b11]/95 backdrop-blur-md border-b border-white/10 transition-colors">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
    <!-- Mobile Hamburger Toggle (44x44px touch target) -->
    <div class="flex items-center md:hidden">
      <button
        type="button"
        id="astro-mobile-menu-btn"
        class="min-w-[44px] min-h-[44px] flex items-center justify-center p-2.5 text-slate-300 hover:text-white active:scale-95 rounded-lg"
        aria-label="Open mobile menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Zone 1: Single text element wordmark -->
    <a
      href="/"
      class="text-xl sm:text-2xl font-bold tracking-wider text-amber-300 hover:text-amber-200 transition-colors font-fantasy whitespace-nowrap py-2"
    >
      RealmForge
    </a>

    <!-- Zone 2: Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-7 text-sm font-medium text-slate-300">
      {navLinks.map((link) => (
        <a
          href={link.path}
          class={`py-2 hover:text-amber-300 transition-colors ${
            currentPath.includes(link.path.replace('/', '')) ? 'text-amber-300 font-semibold' : ''
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Zone 3: Primary Action -->
    <div class="flex items-center gap-2">
      <a
        href="/creatures/dragon-names"
        class="inline-flex items-center gap-1.5 min-h-[36px] px-3.5 py-1.5 text-xs font-semibold text-slate-950 bg-amber-400 hover:bg-amber-300 active:scale-95 rounded-lg transition-colors whitespace-nowrap"
      >
        Dragon Names
      </a>
    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div
    id="astro-mobile-drawer"
    class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-xs flex md:hidden"
  >
    <div class="w-[85vw] max-w-sm h-full bg-[#0b0f19] border-r border-white/10 p-4 sm:p-6 flex flex-col">
      <div class="flex items-center justify-between pb-4 border-b border-white/10">
        <span class="text-xl font-bold font-fantasy text-amber-300">RealmForge</span>
        <button
          type="button"
          id="astro-mobile-close-btn"
          class="min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-400 hover:text-white"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <nav class="flex-1 py-4 space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.path}
            class="min-h-[48px] flex items-center px-3.5 py-3 rounded-xl text-base font-medium text-slate-200 hover:bg-white/5 hover:text-amber-300 active:scale-98"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  const openBtn = document.getElementById('astro-mobile-menu-btn');
  const closeBtn = document.getElementById('astro-mobile-close-btn');
  const drawer = document.getElementById('astro-mobile-drawer');

  if (openBtn && closeBtn && drawer) {
    openBtn.addEventListener('click', () => drawer.classList.remove('hidden'));
    closeBtn.addEventListener('click', () => drawer.classList.add('hidden'));
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.add('hidden');
    });
  }
</script>
