---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Generator } from '../components/Generator.tsx';
import AdBanner from '../components/AdBanner.astro';

const popularGenerators = [
  {
    title: 'Elf Name Generator',
    category: 'fantasy-races',
    slug: 'elf-names',
    description: 'Soft vowels, mystical celestial houses, and lyrical High Elf surnames.',
    icon: '✨',
  },
  {
    title: 'Dwarf Name Generator',
    category: 'fantasy-races',
    slug: 'dwarf-names',
    description: 'Rugged consonants, runic clan lineages, and mountain hall titles.',
    icon: '⚒️',
  },
  {
    title: 'Orc Name Generator',
    category: 'fantasy-races',
    slug: 'orc-names',
    description: 'Guttural combat syllables, fierce war-clan monikers, and battle epithets.',
    icon: '⚔️',
  },
  {
    title: 'Tavern & Inn Names',
    category: 'locations',
    slug: 'tavern-names',
    description: 'Quirky compound alehouses with specialty drinks and atmospheric lore.',
    icon: '🍺',
  },
  {
    title: 'Dragon Name Generator',
    category: 'creatures',
    slug: 'dragon-names',
    description: 'Ancient draconic roots, primordial brimstone titles, and wyrm epithets.',
    icon: '🐉',
  },
];
---

<BaseLayout
  title="RealmForge – Fantasy & RPG Name Generator Hub"
  description="Lightning-fast programmatic name generator for D&D, tabletop roleplaying games, and fantasy novels. Instant 1-click copy, spacebar reroll, and exportable shortlist."
  canonical="https://realmforge.app"
  currentPath="/"
>
  <!-- Hero Section -->
  <section class="text-center py-6 sm:py-12 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-500/10 border border-amber-500/20 rounded-full text-xs text-amber-300 font-medium mb-3 sm:mb-4">
      <span>✨ Algorithmic Syllable Engine</span>
      <span>·</span>
      <span>100,000+ Combinations</span>
    </div>
    
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-fantasy text-slate-100 tracking-tight text-balance">
      Fantasy & RPG Name Generator
    </h1>
    <p class="mt-3 sm:mt-4 text-sm sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Craft authentic character names, roaring mountain clans, quirky wayside taverns, and ancient dragon lords with rich lore and zero latency.
    </p>
  </section>

  <!-- Interactive Quick-Start Generator -->
  <section class="mb-8 sm:mb-12">
    <Generator client:load type="elves" categoryTitle="Elven Kingdoms" />
  </section>

  <!-- AdSense Banner Placeholder -->
  <AdBanner format="horizontal-banner" slotId="home-top-leaderboard" />

  <!-- Directory Hub / Popular Generators -->
  <section class="mt-12 sm:mt-16">
    <div class="flex items-center justify-between mb-6 sm:mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold font-fantasy text-slate-100 tracking-wide">
          Explore Generator Tools
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Select a domain to open dedicated naming conventions, phonetic rules, and tables.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {popularGenerators.map((tool) => (
        <a
          href={`/${tool.category}/${tool.slug}`}
          class="min-h-[140px] p-5 sm:p-6 bg-[#0c101a] border border-white/10 rounded-2xl hover:border-amber-500/40 hover:bg-[#101726] active:scale-[0.98] transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="text-2xl mb-2 sm:mb-3">{tool.icon}</div>
            <h3 class="text-base sm:text-lg font-bold font-fantasy text-slate-100 group-hover:text-amber-200 transition-colors">
              {tool.title}
            </h3>
            <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
              {tool.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-xs text-amber-300/80 group-hover:text-amber-300 font-medium">
            <span>Open Tool & Lore</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
